{
  "esquema": "sv-figura-fuente-1",
  "original_sha256": "4a20336b03d16a52cd12d8807132b71e5bf6910d43cdce93dff39d9d52e621a5",
  "relaciones": "no_inferidas",
  "textos": [
    {
      "id": "t0001",
      "valor": "Un conocimiento, dos preguntas de valoración diferentes"
    },
    {
      "id": "t0002",
      "valor": "La unidad de conocimiento K aporta fundamento. Su pertenencia a la ruta R y la valoración singular del caso son objetos distintos. La pertenencia puede estar acreditada y la cuestión del caso permanecer indeterminada. No se copian valores entre ellas."
    },
    {
      "id": "t0003",
      "valor": "Conocimiento, pertenencia y decisión"
    },
    {
      "id": "t0004",
      "valor": "Ejemplo conceptual; no representa una ruta profesional constituida."
    },
    {
      "id": "t0005",
      "valor": "Unidad de conocimiento K"
    },
    {
      "id": "t0006",
      "valor": "Interpretación de la"
    },
    {
      "id": "t0007",
      "valor": "procedencia de los datos."
    },
    {
      "id": "t0008",
      "valor": "Identidad, fuentes y alcance."
    },
    {
      "id": "t0009",
      "valor": "Sin valor ternario inherente."
    },
    {
      "id": "t0010",
      "valor": "Relación de pertenencia a R"
    },
    {
      "id": "t0011",
      "valor": "¿K pertenece a R bajo las condiciones C?"
    },
    {
      "id": "t0012",
      "valor": "Ejemplo: 0 · Pertenencia acreditada."
    },
    {
      "id": "t0013",
      "valor": "Propuesta de valoración; exige regla y versión."
    },
    {
      "id": "t0014",
      "valor": "Cuestión singular del caso"
    },
    {
      "id": "t0015",
      "valor": "¿Está acreditada la procedencia de este dato?"
    },
    {
      "id": "t0016",
      "valor": "Ejemplo: U · Evidencia del caso insuficiente."
    },
    {
      "id": "t0017",
      "valor": "No hereda el resultado de pertenencia."
    },
    {
      "id": "t0018",
      "valor": "Cada valor conserva su pregunta, contexto, regla, versión y evidencia."
    },
    {
      "id": "t0019",
      "valor": "© 2026 Juan Antonio Lloret Egea. Algunos derechos reservados. | ORCID: 0000-0002-6634-3351 | Instituto Tecnológico Virtual de la Inteligencia Artificial para el Español™ (ITVIA) | IA eñ™ – La Biblia de la IA™ | ISSN 2695-6411 | Licencia Creative Commons Atribución-NoComercial-SinDerivadas 4.0 Internacional (CC BY-NC-ND 4.0)."
    }
  ],
