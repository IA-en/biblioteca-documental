{
  "esquema": "sv-figura-fuente-1",
  "original_sha256": "1a43aece810761485bc66c563cdd18a860f3baf5e2fbd7e5c5a861191ca86897",
  "relaciones": "no_inferidas",
  "textos": [
    {
      "id": "t0001",
      "valor": "Ruta crítica entre cinco elementos de conocimiento"
    },
    {
      "id": "t0002",
      "valor": "Ejemplo conceptual. La regla declarada exige A antes de B, B antes de C, C antes de D y D antes de E, sin omitir ninguno. La ruta A B C D E es la única que satisface estas condiciones. A B D E omite C; A C B D E incumple una dependencia. El recorrido registrado se representa aparte: A y B acreditados, C pendiente, D y E no admitidos todavía."
    },
    {
      "id": "t0003",
      "valor": "Ruta crítica: conocimiento necesario y dependencias"
    },
    {
      "id": "t0004",
      "valor": "Ejemplo conceptual; no constituye una ruta profesional ni un algoritmo de decisión."
    },
    {
      "id": "t0005",
      "valor": "Regla del ejemplo"
    },
    {
      "id": "t0006",
      "valor": "Se requieren A, B, C, D y E; cada elemento depende del anterior. No se admite omitirlos."
    },
    {
      "id": "t0007",
      "valor": "1. Ruta crítica declarada"
    },
    {
      "id": "t0008",
      "valor": "A"
    },
    {
      "id": "t0009",
      "valor": "B"
    },
    {
      "id": "t0010",
      "valor": "C"
    },
    {
      "id": "t0011",
      "valor": "D"
    },
    {
      "id": "t0012",
      "valor": "E"
    },
    {
      "id": "t0013",
      "valor": "Flecha: dependencia exigida. Cada elemento identifica conocimiento completo o una parte delimitada."
    },
    {
      "id": "t0014",
      "valor": "2. Variaciones que no satisfacen la regla"
    },
    {
      "id": "t0015",
      "valor": "A → B → D → E"
    },
    {
      "id": "t0016",
      "valor": "Falta C: omisión de conocimiento necesario."
    },
    {
      "id": "t0017",
      "valor": "A → C → B → D → E"
    },
    {
      "id": "t0018",
      "valor": "Incluye todos; C se recorre antes de su requisito B."
    },
    {
      "id": "t0019",
      "valor": "3. Recorrido efectivamente registrado: ejemplo parcial"
    },
    {
      "id": "t0020",
      "valor": "A, B: acreditados · C: pendiente · D, E: todavía no admitidos"
    },
    {
      "id": "t0021",
      "valor": "La ruta dibujada no acredita su cumplimiento. Cada paso necesita su evidencia."
    },
    {
      "id": "t0022",
      "valor": "Al seleccionar C: Universo y parámetros → documento y versión → páginas o pasajes → evidencia."
    },
    {
      "id": "t0023",
      "valor": "La unicidad procede de las reglas de este ejemplo. La criticidad real exige una definición autorizada."
    },
    {
      "id": "t0024",
      "valor": "© 2026 Juan Antonio Lloret Egea. Algunos derechos reservados. | ORCID: 0000-0002-6634-3351 | Instituto Tecnológico Virtual de la Inteligencia Artificial para el Español™ (ITVIA) | IA eñ™ – La Biblia de la IA™ | ISSN 2695-6411 | Licencia Creative Commons Atribución-NoComercial-SinDerivadas 4.0 Internacional (CC BY-NC-ND 4.0)."
    }
  ],
