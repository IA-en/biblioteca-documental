  "textos": [
    {
      "id": "t0001",
      "valor": "Del Universo a la ejecución tensorial conservando las células y sus frames"
    },
    {
      "id": "t0002",
      "valor": "El Universo y sus parámetros se realizan mediante células constituidas. Sus estados pueden organizarse en matrices y tensores para ejecutar operaciones autorizadas. Cada instancia conserva posiciones, significado, evidencia y correspondencia con su frame. Es un concepto de diseño."
    },
    {
      "id": "t0003",
      "valor": "Realización computable del Universo"
    },
    {
      "id": "t0004",
      "valor": "Concepto de diseño: cada transformación conserva el significado y la identidad."
    },
    {
      "id": "t0005",
      "valor": "Universo"
    },
    {
      "id": "t0006",
      "valor": "Parámetros, fuentes"
    },
    {
      "id": "t0007",
      "valor": "y relaciones."
    },
    {
      "id": "t0008",
      "valor": "Células SV"
    },
    {
      "id": "t0009",
      "valor": "Posiciones y contratos."
    },
    {
      "id": "t0010",
      "valor": "Estado por instancia."
    },
    {
      "id": "t0011",
      "valor": "Matrices y tensores"
    },
    {
      "id": "t0012",
      "valor": "Datos organizados."
    },
    {
      "id": "t0013",
      "valor": "Identidad por célula."
    },
    {
      "id": "t0014",
      "valor": "Operaciones"
    },
    {
      "id": "t0015",
      "valor": "Significado autorizado."
    },
    {
      "id": "t0016",
      "valor": "Resultado comprobado."
    },
    {
      "id": "t0017",
      "valor": "Frame: estado matemático y representación visual"
    },
    {
      "id": "t0018",
      "valor": "Misma instancia, posiciones, constitución y versión."
    },
    {
      "id": "t0019",
      "valor": "La disposición de almacenamiento no altera la dimensión de la célula ni constituye una decisión."
    },
    {
