{
  "esquema": "sv-figura-fuente-1",
  "original_sha256": "3a2512c3d3726027742095326f7d661f9c2df0bddfc75d199428d74904ecd37f",
  "relaciones": "no_inferidas",
  "textos": [
    {
      "id": "t0001",
      "valor": "Hipótesis de una escala aeroportuaria con tareas paralelas"
    },
    {
      "id": "t0002",
      "valor": "Cinco bloques didácticos: A coordinación inicial, cinco minutos; B preparación de cabina, doce; C preparación de equipaje, siete; D comprobación conjunta, cuatro; E cierre del proceso, tres. B y C se realizan en paralelo después de A; D requiere que ambas terminen. A B D E determina los veinticuatro minutos totales. C tiene cinco minutos de margen, pero sigue siendo obligatoria."
    },
    {
      "id": "t0003",
      "valor": "Aeropuerto: dependencias, simultaneidad y demora"
    },
    {
      "id": "t0004",
      "valor": "Hipótesis didáctica. Actividades agregadas y tiempos inventados; no es un procedimiento operativo."
    },
    {
      "id": "t0005",
      "valor": "A · Coordinación"
    },
    {
      "id": "t0006",
      "valor": "inicial"
    },
    {
      "id": "t0007",
      "valor": "5 min"
    },
    {
      "id": "t0008",
      "valor": "B · Preparación de cabina"
    },
    {
      "id": "t0009",
      "valor": "12 min"
    },
    {
      "id": "t0010",
      "valor": "C · Preparación de equipaje"
    },
    {
      "id": "t0011",
      "valor": "7 min"
    },
    {
      "id": "t0012",
      "valor": "D · Comprobación"
    },
    {
      "id": "t0013",
      "valor": "de ambos bloques"
    },
    {
      "id": "t0014",
      "valor": "4 min"
    },
    {
      "id": "t0015",
      "valor": "E · Cierre"
    },
    {
      "id": "t0016",
      "valor": "3 min"
    },
    {
      "id": "t0017",
      "valor": "Ruta crítica temporal: A → B → D → E = 24 minutos"
    },
    {
      "id": "t0018",
      "valor": "La secuencia A → C → D → E suma 19 minutos. C tiene 5 minutos de margen, pero no se omite."
    },
    {
      "id": "t0019",
      "valor": "Azul grueso: ruta que fija la duración. Gris: dependencia necesaria con margen temporal."
    },
    {
      "id": "t0020",
      "valor": "En el SV, la criticidad se fundamenta en el conocimiento y las consecuencias de su omisión."
    },
    {
      "id": "t0021",
      "valor": "© 2026 Juan Antonio Lloret Egea. Algunos derechos reservados. | ORCID: 0000-0002-6634-3351 | Instituto Tecnológico Virtual de la Inteligencia Artificial para el Español™ (ITVIA) | IA eñ™ – La Biblia de la IA™ | ISSN 2695-6411 | Licencia Creative Commons Atribución-NoComercial-SinDerivadas 4.0 Internacional (CC BY-NC-ND 4.0)."
    }
  ],
