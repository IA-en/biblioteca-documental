{
  "esquema": "sv-figura-fuente-1",
  "original_sha256": "94717a53abc750a61a7609e2151fca9e055ba90b49f089dac8d68b29acaaee9a",
  "relaciones": "no_inferidas",
  "textos": [
    {
      "id": "t0001",
      "valor": "Nueve destinos: cobertura completa y orden del recorrido"
    },
    {
      "id": "t0002",
      "valor": "Un recorrido hipotético visita los destinos 1, 4, 2, 8, 5, 7, 3, 9 y 6. Contiene los nueve destinos una vez. Esto acredita cobertura, no un mínimo de tiempo o combustible, que exige datos y criterios adicionales."
    },
    {
      "id": "t0003",
      "valor": "Reparto planificado: nueve destinos obligatorios"
    },
    {
      "id": "t0004",
      "valor": "Secuencia hipotética. La posición en el dibujo no representa distancias geográficas."
    },
    {
      "id": "t0005",
      "valor": "1"
    },
    {
      "id": "t0006",
      "valor": "4"
    },
    {
      "id": "t0007",
      "valor": "2"
    },
    {
      "id": "t0008",
      "valor": "8"
    },
    {
      "id": "t0009",
      "valor": "5"
    },
    {
      "id": "t0010",
      "valor": "7"
    },
    {
      "id": "t0011",
      "valor": "3"
    },
    {
      "id": "t0012",
      "valor": "9"
    },
    {
      "id": "t0013",
      "valor": "6"
    },
    {
      "id": "t0014",
      "valor": "Cobertura: aparecen los nueve destinos, sin omisiones ni duplicaciones."
    },
    {
      "id": "t0015",
      "valor": "Elección del orden: necesita distancias, tiempos, consumo, restricciones y criterios declarados."
    },
    {
      "id": "t0016",
      "valor": "En el SV: comprobar todo el conocimiento exigido y sus dependencias, con evidencia por paso."
    },
    {
      "id": "t0017",
      "valor": "Este esquema es una analogía logística; no constituye una célula SV ni una ruta profesional."
    },
    {
      "id": "t0018",
